{
  "name": "synthesis-truststack",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "synthesis-truststack",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/agent-core": {
      "name": "@truststack/agent-core",
      "version": "0.1.0",
      "dependencies": {
        "@truststack/receipt-sdk": "*"
      }
    },
    "node_modules/@truststack/agent-core": {
      "resolved": "apps/agent-core",
      "link": true
    },
    "node_modules/@truststack/receipt-sdk": {
      "resolved": "packages/receipt-sdk",
      "link": true
    },
    "packages/receipt-sdk": {
      "name": "@truststack/receipt-sdk",
      "version": "0.1.0"
    }
  }
}
